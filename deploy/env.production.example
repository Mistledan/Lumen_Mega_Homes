# Copy to the server as /var/www/lumen/.env and fill in real values.
# Generate a strong pepper:  openssl rand -hex 32
NODE_ENV=production
API_PORT=5000

WEB_ORIGIN=https://lumenmegahomes.com
INTERNAL_API_URL=http://127.0.0.1:5000/api/v1

# Used by the browser (Next build). Relative so it goes through nginx.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SITE_URL=https://lumenmegahomes.com

# PostgreSQL on the VPS (or Hostinger Cloud DB connection string)
DATABASE_URL=postgresql://lumen:CHANGE_ME@127.0.0.1:5432/lumen_megahomes?schema=public
# Direct connection (no pooler) used for migrations
DIRECT_URL=postgresql://lumen:CHANGE_ME@127.0.0.1:5432/lumen_megahomes?schema=public

# Admin login used by the seed script (upserted automatically)
ADMIN_EMAIL=admin@lumenmegahomes.com
ADMIN_PASSWORD=STRONG_PASSWORD_HERE
PASSWORD_PEPPER=RANDOM_64_HEX_HERE

# Optional: session length in days (default 7)
SESSION_DAYS=7

# Seed-time site contact values (only read when seeding a fresh database)
SITE_PHONE=07033656721
SITE_EMAIL=obmilnetworks@hotmail.com
SITE_ADDRESS=Lagos, Nigeria